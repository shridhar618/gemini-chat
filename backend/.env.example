# ================================
# Gemini Chat Backend - Environment Variables
# ================================
# Copy this file to .env and fill in your values

# --- REQUIRED ---
# Your Google Gemini API Key
# Get it from: https://makersuite.google.com/app/apikey
# Use a Google API key, not an OAuth access token.
# A valid key typically starts with "AIza".
GEMINI_API_KEY=your_key_here

# --- OPTIONAL ---
# Gemini model to use (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash

# Response creativity (0.0 = deterministic, 1.0 = creative)
GEMINI_TEMPERATURE=0.7

# Server settings
PORT=5000
FLASK_DEBUG=true
